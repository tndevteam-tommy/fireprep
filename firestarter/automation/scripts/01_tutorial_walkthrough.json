   "walk_to": {
    "item": "Birch bark curls"
   },
   "stop": 1.35,
   "timeout": 12
  },
  {
   "aim_at": {
    "item": "Birch bark curls"
   },
   "duration": 0.35
  },
  {
   "assert": "world.target is not None and world.target['kind'] == 'tinder_source'",
   "message": "crosshair targets the birch curls"
