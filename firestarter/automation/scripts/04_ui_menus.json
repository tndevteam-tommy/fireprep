  },
  {
   "screenshot": "04_book_teepee_pinned"
  },
  {
   "key": "d"
  },
  {
   "key": "d"
  },
  {
   "wait": 0.1
  },
  {
   "assert": "book.get_current_page_data()['locked']",
   "message": "advanced blueprints start locked"
  },
  {
   "key": "return"
  },
  {
   "wait": 0.1
  },
  {
   "assert": "book.selected_blueprint_key == 'teepee'",
   "message": "a locked blueprint cannot be pinned"
  },
  {
   "screenshot": "05_book_locked_lean_to"
  },
  {
   "key": "d"
  },
  {
   "key": "d"
  },
  {
   "key": "d"
  },
  {
   "key": "d"
  },
  {
   "key": "d"
  },
  {
   "wait": 0.1
  },
  {
   "screenshot": "06_book_seasoning_chart"
  },
  {
   "key": "b"
  },
  {
   "wait": 0.2
  },
  {
   "assert": "not book.is_open",
   "message": "B closes the book"
  },
  {
   "walk_to": {
    "item": "Bundle of dead pine twigs"
   },
   "stop": 1.3,
   "timeout": 12
  },
  {
   "aim_at": {
    "item": "Bundle of dead pine twigs"
   }
  },
  {
   "click": "left"
  },
  {
   "wait": 0.2
  },
  {
   "walk_to": {
    "pit": [
     0,
     0,
     0
    ]
   },
   "stop": 1.3,
   "timeout": 12
  },
  {
   "key": "7"
  },
  {
   "aim_at": {
    "pit": [
     0.12,
     0.0,
     0.02
    ]
   }
  },
  {
   "wait": 0.2
  },
  {
   "assert": "world.ghost is not None and world.ghost['slot'] is not None",
