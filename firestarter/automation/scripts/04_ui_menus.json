{
 "name": "04_ui_menus",
 "description": "Help, Field Compendium, blueprint holograms, smartphone Home/Store/Topo Map, time menu, pause & settings.",
 "settings": {
  "width": 1280,
  "height": 720,
  "seed": 7,
  "start_hour": 18.5,
  "fixed_dt": 0.0333,
  "preset": "High",
  "render_stride": 40,
  "no_tutorial": true
 },
 "steps": [
  {
   "log": "UI: help overlay, Field Compendium (pin a blueprint -> hologram snapping), smartphone apps, time menu, pause settings"
  },
  {
   "wait": 0.3
  },
  {
   "key": "h"
  },
  {
   "wait": 0.2
  },
  {
   "screenshot": "01_help_overlay"
  },
  {
   "assert": "input.show_help",
   "message": "H shows the controls overlay"
  },
  {
   "key": "h"
  },
  {
   "key": "b"
  },
  {
   "wait": 0.3
  },
  {
   "assert": "book.is_open and book.current_page == 0",
   "message": "B opens the Field Compendium"
  },
  {
   "screenshot": "02_book_combustion"
  },
  {
   "key": "d"
  },
  {
   "wait": 0.1
  },
  {
   "screenshot": "03_book_species"
  },
  {
   "key": "d"
  },
  {
   "key": "d"
  },
  {
   "key": "d"
  },
  {
   "wait": 0.1
  },
  {
   "assert": "book.get_current_page_data()['key'] == 'teepee'",
   "message": "paged forward to the Teepee blueprint"
  },
  {
   "key": "return"
  },
  {
   "wait": 0.1
  },
  {
   "assert": "book.selected_blueprint_key == 'teepee'",
