   "value": "world.ghost and world.ghost['slot']"
  },
  {
   "screenshot": "07_blueprint_hologram"
  },
  {
   "click": "right"
  },
  {
   "wait": 0.2
  },
  {
   "key": "tab"
  },
  {
   "wait": 0.3
  },
  {
   "screenshot": "08_phone_home"
  },
  {
   "key": "right"
  },
  {
   "key": "return"
  },
  {
   "wait": 0.3
  },
  {
   "assert": "phone.active_app.value == 'Topographical Map'",
   "message": "opened the Topo Map app"
  },
  {
   "screenshot": "09_phone_topo_map"
  },
  {
   "key": "w"
  },
  {
   "key": "w"
  },
  {
   "wait": 0.2
  },
  {
   "assert": "phone.map_zoom > 1.4",
   "message": "W zooms the map in",
   "value": "phone.map_zoom"
  },
  {
   "screenshot": "10_phone_topo_zoomed"
  },
  {
   "key": "backspace"
  },
  {
   "key": "left"
  },
  {
   "key": "return"
  },
  {
   "wait": 0.2
  },
  {
   "assert": "phone.active_app.value == 'Store ($)'",
   "message": "back home, then into the Store"
  },
  {
   "exec": "scratch['cr'] = phone.credits.credits"
  },
  {
   "key": "return"
  },
  {
   "wait": 0.2
  },
  {
   "assert": "phone.credits.credits == scratch['cr'] and 'Insufficient' in phone.status_message",
   "message": "cannot buy a lighter refill with 20 credits",
   "value": "phone.status_message"
  },
  {
   "expect_sound": "ui_error"
  },
  {
   "screenshot": "11_phone_store"
  },
  {
   "key": "tab"
  },
  {
   "wait": 0.2
  },
  {
   "exec": "scratch['clock'] = weather.total_hours"
  },
  {
   "key": "t"
  },
  {
   "key": "s"
  },
  {
   "key": "s"
  },
  {
   "wait": 0.2
  },
  {
   "screenshot": "12_time_menu"
  },
  {
   "key": "escape"
  },
  {
   "wait": 0.2
  },
  {
   "assert": "not world.time_engine.is_menu_open and weather.total_hours - scratch['clock'] < 0.01",
   "message": "Esc cancels the time menu without skipping"
  },
  {
   "key": "escape"
  },
  {
   "wait": 0.2
  },
  {
   "assert": "input.is_paused",
   "message": "Esc pauses the game"
  },
  {
   "exec": "scratch['t_sim'] = world.sim_time"
  },
  {
   "wait": 0.5
  },
  {
   "assert": "abs(world.sim_time - scratch['t_sim']) < 1e-6",
   "message": "the simulation is frozen while paused"
  },
  {
   "key": "s"
  },
  {
   "key": "d"
  },
  {
   "key": "d"
  },
  {
   "assert": "abs(input.settings.master_volume - 1.0) < 1e-6",
   "message": "D raises the master volume",
   "value": "input.settings.master_volume"
  },
  {
   "key": "s"
  },
  {
   "key": "s"
  },
  {
   "key": "s"
  },
  {
   "key": "a"
  },
  {
   "wait": 0.2
  },
  {
   "assert": "input.settings.graphics_preset == 'Medium'",
   "message": "A steps the graphics preset down"
  },
  {
   "screenshot": "13_pause_settings"
  },
  {
   "assert": "renderer.preset_name == 'Medium'",
   "message": "the renderer applied the new preset"
  },
  {
   "key": "escape"
  },
  {
   "wait": 0.2
  },
  {
   "assert": "not input.is_paused",
   "message": "Esc resumes"
  }
 ]
}